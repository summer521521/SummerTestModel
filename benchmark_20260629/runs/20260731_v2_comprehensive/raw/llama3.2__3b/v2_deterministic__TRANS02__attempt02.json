  "response": "以下是Python代码，实现cache key、HTTP 429、Retry-After、tenant_id的功能：\n\n```python\nimport requests\nfrom flask import Flask, request, jsonify\nfrom functools import wraps\n\napp = Flask(__name__)\n\n# 缓存字典\ncache_dict = {}\n\ndef cache_key(tenant_id):\n    return f\"tenant_{tenant_id}\"\n\ndef retry_with_cache(func):\n    @wraps(func)\n    def wrapper(*args, **kwargs):\n        tenant_id = kwargs.get('tenant_id')\n        if not tenant_id:\n            raise ValueError(\"tenant_id is required\")\n\n        cache_key_name = cache_key(tenant_id)\n\n        # 读取缓存\n        if cache_key_name in cache_dict:\n            return cache_dict[cache_key_name]\n\n        try:\n            # 尝试获取数据\n            response = func(*args, **kwargs)\n            # 缓存数据\n            cache_dict[cache_key_name] = response.json()\n            return response.json()\n\n        except requests.exceptions.HTTPError as e:\n            if e.response.status_code == 429:\n                # 如果返回429，读取Retry-After头部，等待retry_after秒后再尝试\n                retry_after = int(e.response.headers.get('Retry-After', 0))\n                time.sleep(retry_after)\n                return retry_with_cache(func)(*args, **kwargs)\n\n            raise\n\n    return wrapper\n\n# 例子函数\n@retry_with_cache\ndef get_data(tenant_id):\n    # Simulate a slow API call\n    import time\n    time.sleep(2)\n    return {'data': 'Hello World!'}, 200\n\n@app.route('/get_data', methods=['GET'])\ndef get_data_route():\n    tenant_id = request.args.get('tenant_id')\n    try:\n        data = get_data(tenant_id=tenant_id)\n        return jsonify(data)\n    except Exception as e:\n        return jsonify({'error': str(e)}), 500\n\nif __name__ == '__main__':\n    app.run(debug=True)\n```\n\n在这个例子中，我们定义了一个`retry_with_cache`装饰器，用于实现缓存和重试功能。它首先尝试获取数据，如果返回429，则读取Retry-After头部等待retry_after秒后再尝试。\n\n我们还定义了一个`get_data`函数，它模拟了一个慢API的调用，需要使用`retry_with_cache`装饰器来实现缓存和重试功能。",
