  "response": "def topological_order(tasks, dependencies):\n    from collections import defaultdict, deque\n\n    # Build adjacency list and in-degree map\n    graph = defaultdict(list)\n    indeg = {t: 0 for t in tasks}\n    for u, v in dependencies:\n        if v not in indeg:\n            raise ValueError(\"Dependency target not in tasks\")\n        graph[u].append(v)\n        indeg[v] += 1\n\n    # Prepare queue of zero-in-degree nodes\n    q = deque([t for t in indeg if indeg[t] == 0])\n    order = []\n\n    while q:\n        u = q.popleft()\n        order.append(u)\n        for v in graph[u]:\n            indeg[v] -= 1\n            if indeg[v] == 0:\n                q.append(v)\n\n    # If all tasks not ordered => cycle exists\n    if len(order) != len(tasks):\n        return []\n\n    # Lexicographically smallest: sort at each step (since we pop left, use sorted queue)\n    # But to ensure lexicographic min, always pick the smallest available node\n    # So maintain a heap for available nodes\n    import heapq\n    avail = []\n    for t in indeg:\n        if indeg[t] == 0:\n            heapq.heappush(avail, t)\n\n    result = []\n    while avail:\n        u = heapq.heappop(avail)\n        result.append(u)\n        for v in graph[u]:\n            indeg[v] -= 1\n            if indeg[v] == 0:\n                heapq.heappush(avail, v)\n\n    # Same cycle check as before\n    if len(result) != len(tasks):\n        return []\n    return result",
