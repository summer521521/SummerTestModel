unts(lines):\n    info_count = 0\n    warn_count = 0\n    error_count = 0\n\n    for record in lines.split('\\n'):\n        content = record.strip()\n        if not content:\n            continue\n        \n        # Check each type of log message\n        if content.startswith('INFO '):\n            num_str = content[4:].strip()\n            if num_str.isdigit():\n                info_count += 1\n        elif content.startswith('WARN '):\n            num_str = content[5:].strip()\n            if num_str.isdigit():\n                warn_count += 1\n        elif content.startswith('ERROR '):\n            num_str = content[6:].strip()\n            if num_str.isdigit():\n                error_count += 1\n\n    return {\n        'INFO': info_count,\n        'WARN': warn_count,\n        'ERROR': error_count\n    }\n```",
